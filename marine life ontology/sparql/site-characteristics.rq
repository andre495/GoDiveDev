# Site characteristic graph queries
# Site hub: Country, BodyOfWater, WaterType, catalog depth, SiteReport, Sighting
#
# PREFIX mlo: <https://example.org/marine-life/>

#################################################################
# 1) Sites in a country (resource link)
#################################################################

PREFIX mlo: <https://example.org/marine-life/>

SELECT ?site ?siteName ?maxDepth ?waterType WHERE {
  ?site a mlo:Site ;
        mlo:inCountry <https://example.org/marine-life/country/Australia> ;
        mlo:siteName ?siteName .
  OPTIONAL { ?site mlo:siteMaxDepthM ?maxDepth }
  OPTIONAL { ?site mlo:siteWaterType ?waterType }
}
ORDER BY ?siteName
LIMIT 50

