rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isInviteOpen() {
      return resource.data.status == 'open'
        && resource.data.expiresAt > request.time;
    }

    function friendshipMembers() {
      return request.resource.data.members;
    }

    function areFriends(a, b) {
      let pair = a < b ? a + '_' + b : b + '_' + a;
      return exists(/databases/$(database)/documents/friendships/$(pair))
        && get(/databases/$(database)/documents/friendships/$(pair)).data.status == 'active'
        && a in get(/databases/$(database)/documents/friendships/$(pair)).data.members
        && b in get(/databases/$(database)/documents/friendships/$(pair)).data.members;
    }

    // Social directory — signed-in users can read public profiles; only owner writes.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;

      // Apple ID link — owner only (never returned by public profile reads).
      match /private/{docId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Friend-visible dive projections — owner write; friends (or owner) read.
      // `likeCount` / `commentCount` are Admin SDK only (Cloud Function).
      match /sharedDives/{diveId} {
        allow read: if signedIn()
          && (request.auth.uid == userId || areFriends(request.auth.uid, userId));
        allow create: if signedIn()
          && request.auth.uid == userId
          && !('likeCount' in request.resource.data)
          && !('commentCount' in request.resource.data);
        allow update: if signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['likeCount', 'commentCount']);
        allow delete: if signedIn() && request.auth.uid == userId;

        // Per-liker docs — friends create/delete their own; tally lives on parent via CF.
        match /likes/{likerUid} {
          allow read: if signedIn()
            && (
              request.auth.uid == userId
              || request.auth.uid == likerUid
              || areFriends(request.auth.uid, userId)
            );
          allow create: if signedIn()
            && request.auth.uid == likerUid
            && request.auth.uid != userId
            && areFriends(request.auth.uid, userId)
            && request.resource.data.keys().hasOnly(['createdAt', 'displayName'])
            && request.resource.data.createdAt == request.time
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 80;
          allow delete: if signedIn() && request.auth.uid == likerUid;
          allow update: if false;
        }

        // Activity comments — owner or friends read/create; author delete only.
        match /comments/{commentId} {
          allow read: if signedIn()
            && (request.auth.uid == userId || areFriends(request.auth.uid, userId));
          allow create: if signedIn()
            && (
              request.auth.uid == userId
              || areFriends(request.auth.uid, userId)
            )
            && request.resource.data.keys().hasOnly([
              'authorUid', 'displayName', 'text', 'createdAt', 'mentionedUids'
            ])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 80
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && (
              !('mentionedUids' in request.resource.data)
              || (
                request.resource.data.mentionedUids is list
                && request.resource.data.mentionedUids.size() <= 10
              )
            );
          allow delete: if signedIn()
            && resource.data.authorUid == request.auth.uid;
          allow update: if false;
        }
      }

      // Private staging for anonymized community sighting contributions (owner only).
      // Cloud Function mirrors active docs into communitySightings/{contributionId}.
      match /ontologySightingContributions/{sightingUUID} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Private staging for SiteReport (1:1 with dive/snorkel activity).
      // Cloud Function mirrors into communitySiteReports/{contributionId}.
      match /ontologySiteReportContributions/{activityUUID} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // One-shot push signal after projection upsert — owner get/create/delete;
      // Cloud Function (Admin SDK) reads. Owner get is required so the client can
      // create-once without racing a blind setData that would become a denied update.
      match /buddySharePushSignals/{activityId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.activityKind in ['snorkel', 'scubaDive']
          && request.resource.data.startTime is timestamp
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // QR / link invites — creator writes; any signed-in user can read by token; redeem updates status.
    match /friendInvites/{token} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow read: if signedIn();
      allow update: if signedIn() && (
        resource.data.fromUid == request.auth.uid
        || (
          isInviteOpen()
          && request.resource.data.status == 'redeemed'
          && request.resource.data.redeemedBy == request.auth.uid
          && request.auth.uid != resource.data.fromUid
        )
      );
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Mutual friendship (doc id = sorted uidA_uidB).
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in friendshipMembers()
        && friendshipMembers().size() == 2
        && request.resource.data.status == 'active'
        && request.resource.data.inviteToken is string
        && exists(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteToken))
        && get(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteToken)).data.status == 'open'
        && get(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteToken)).data.fromUid in friendshipMembers()
        && request.auth.uid != get(/databases/$(database)/documents/friendInvites/$(request.resource.data.inviteToken)).data.fromUid;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if false;
    }

    // Anonymized community sighting events — signed-in read; Admin SDK write only.
    match /communitySightings/{contributionId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Anonymized SiteReport visits (1:1 activity) — signed-in read; Admin SDK write only.
    match /communitySiteReports/{contributionId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Derived catalog meta (species similarity checksum) — signed-in read; Admin SDK write.
    match /catalogMeta/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
