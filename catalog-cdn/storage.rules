rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAcceptedBuddy(ownerUid, requesterUid) {
      let pair = ownerUid < requesterUid
        ? ownerUid + '_' + requesterUid
        : requesterUid + '_' + ownerUid;
      let doc = firestore.get(/databases/(default)/documents/friendships/$(pair));
      return doc != null
        && doc.data.status == 'active'
        && ownerUid in doc.data.members
        && requesterUid in doc.data.members;
    }

    // Public catalog assets only — no user dive data.
    match /catalog/v1/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Social profile avatars — owner write; readable so `photoURL` download tokens work for friends UI.
    match /users/{userId}/profile.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profileHero.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profileHero.mp4 {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType == 'video/mp4';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Schema v3 friend-shared activity media (thumb / full photo / 1080p video).
    // Owner or accepted buddy may get; only owner may list.
    match /users/{userId}/sharedMedia/{activityId}/{mediaId}/{fileName} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAcceptedBuddy(userId, request.auth.uid));
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (
                     (fileName == 'thumb.jpg'
                       && request.resource.size < 1 * 1024 * 1024
                       && request.resource.contentType.matches('image/.*'))
                     ||
                     (fileName == 'photo.jpg'
                       && request.resource.size < 8 * 1024 * 1024
                       && request.resource.contentType == 'image/jpeg')
                     ||
                     (fileName == 'video.mp4'
                       && request.resource.size < 50 * 1024 * 1024
                       && request.resource.contentType == 'video/mp4')
                   );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy v2 flat preview JPEG (`{mediaId}.jpg` directly under activity folder).
    // Owner or accepted buddy may get; only owner may list.
    match /users/{userId}/sharedMedia/{activityId}/{legacyFileName} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isAcceptedBuddy(userId, request.auth.uid));
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Catch-all for other user paths — owner read/delete only.
    match /users/{userId}/{allPaths=**} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
